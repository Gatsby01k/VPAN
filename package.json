{
  "name": "vpan-private-affiliate-network",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node server.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite",
    "dev:server": "node --watch server.mjs",
    "check": "tsc --noEmit",
    "format": "prettier --write src scripts server.mjs tests vite.config.ts tsconfig.json package.json index.html",
    "format:check": "prettier --check src scripts server.mjs tests vite.config.ts tsconfig.json package.json index.html",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist-server && node scripts/prerender.mjs",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/oswald": "5.3.0",
    "lucide-react": "1.53.0",
    "motion": "14.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
