PORT=3000
HOST=0.0.0.0
DB_PATH=./data/partners.sqlite
ADMIN_TOKEN=replace-with-long-random-secret-at-least-32-characters
ALLOWED_ORIGIN=
TRUST_PROXY=0

# Exact public HTTPS origin. Never derive canonical URLs from request headers.
PUBLIC_SITE_URL=
# Runs on server startup and every six hours while the persistent service is running.
GROWTH_ENABLED=1
# One AI attempt and one autonomous publication per day, after quality gates.
GROWTH_AI_AUTOPUBLISH=1
AI_GATEWAY_API_KEY=
# Choose a structured-output language model ID from https://ai-gateway.vercel.sh/v1/models
AI_GATEWAY_MODEL=
# Read-only Google service account with access to the verified Search Console property.
# Keep the credentials outside the repository; mount the file read-only in Docker.
GSC_SERVICE_ACCOUNT_FILE=
GSC_PROPERTY=
