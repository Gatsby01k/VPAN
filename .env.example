PORT=3000
HOST=0.0.0.0
# auto uses durable intake after /health verification, with a manual Telegram fallback.
# Force telegram or desk only when that operational choice has been verified.
VITE_BRIEF_DELIVERY=auto
DB_PATH=./data/partners.sqlite
ADMIN_TOKEN=replace-with-long-random-secret-at-least-32-characters
ALLOWED_ORIGIN=
TRUST_PROXY=0

# Exact public HTTPS origin. Never derive canonical URLs from request headers.
PUBLIC_SITE_URL=
# Runs on server startup and every six hours while the persistent service is running.
GROWTH_ENABLED=1
# One AI attempt and one autonomous publication per day, after quality gates.
GROWTH_AI_AUTOPUBLISH=0
AI_GATEWAY_API_KEY=
# Choose a structured-output language model ID from https://ai-gateway.vercel.sh/v1/models
AI_GATEWAY_MODEL=
# Read-only Google service account with access to the verified Search Console property.
# Keep the credentials outside the repository; mount the file read-only in Docker.
GSC_SERVICE_ACCOUNT_FILE=
GSC_PROPERTY=

# Authenticated HTTPS receiver for durable at-least-once new-enquiry notifications.
# It must accept POST JSON and Idempotency-Key; 2xx confirms delivery.
# Payload contains only an event ID, reference and desk path, without applicant contacts.
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_SECRET=
# Optional direct Telegram alerts. Pair a private chat in Deal Desk → Notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Optional: only for a split Vercel frontend + persistent backend deployment.
# Set these on Vercel; set the same gateway token on the backend.
INTAKE_SERVICE_ORIGIN=
INTAKE_GATEWAY_TOKEN=

# Vercel Marketplace Turso connection. Keep these in the hosting environment.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Authenticates the Vercel daily outbox/editorial maintenance request.
CRON_SECRET=
