{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/affiliates",
      "destination": "/join",
      "permanent": true
    },
    {
      "source": "/teams",
      "destination": "/join",
      "permanent": true
    },
    {
      "source": "/payment-partners",
      "destination": "/join",
      "permanent": true
    },
    {
      "source": "/merchants",
      "destination": "/find-a-partner",
      "permanent": true
    },
    {
      "source": "/apply",
      "has": [
        {
          "type": "query",
          "key": "role",
          "value": "(affiliate|team|provider|regional)"
        }
      ],
      "destination": "/join",
      "permanent": true
    },
    {
      "source": "/apply",
      "destination": "/find-a-partner",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/service?_route=/api/:path*"
    },
    {
      "source": "/health",
      "destination": "/api/service?_route=/health"
    },
    {
      "source": "/feed.xml",
      "destination": "/api/service?_route=/feed.xml"
    },
    {
      "source": "/knowledge/:slug",
      "destination": "/api/service?_route=/knowledge/:slug"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "ru"
        }
      ],
      "destination": "/__pages/ru/index.html"
    },
    {
      "source": "/:page*",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "ru"
        }
      ],
      "destination": "/__pages/ru/:page*/index.html"
    },
    {
      "source": "/",
      "destination": "/__pages/en/index.html"
    },
    {
      "source": "/:page*",
      "destination": "/__pages/en/:page*/index.html"
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self' mailto:"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/shell.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/__pages/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
